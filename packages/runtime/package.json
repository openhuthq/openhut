{
  "name": "@openhut/runtime",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --no-node-snapshot src/server/app.ts",
    "typecheck": "tsc -p .",
    "test": "node --no-node-snapshot --test --test-force-exit ${TEST_SHARD:+--test-shard=$TEST_SHARD} --test-concurrency=1 --import ./test/server/env.ts \"test/server/**/*.test.ts\" \"test/core/**/*.test.ts\" \"test/plugins/**/*.test.ts\" \"test/adapters/**/*.test.ts\" && node --no-node-snapshot --test --test-force-exit ${TEST_SHARD:+--test-shard=$TEST_SHARD} --import ./test/tmp.ts \"test/agentd/**/*.test.ts\""
  },
  "dependencies": {
    "@chat-adapter/discord": "4.45.0",
    "@chat-adapter/state-pg": "4.45.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/websocket": "11.3.7",
    "@json-render/core": "0.23.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openhut/common": "*",
    "ai": "7.0.172",
    "chat": "4.45.0",
    "convex": "1.51.0",
    "croner": "11.0.0",
    "env-var": "7.5.0",
    "evlog": "2.29.0",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "isolated-vm": "6.2.0",
    "kysely": "0.29.6",
    "nodemailer": "10.6.1",
    "partysocket": "1.3.0",
    "pg": "8.23.0",
    "pg-boss": "^12.40.0",
    "simple-icons": "16.38.1",
    "undici": "7.30.1",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
