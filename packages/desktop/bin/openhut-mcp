#!/bin/sh
home="${OPENHUT_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
sock="${OPENHUT_MCP_SOCKET:-$home/mcp.sock}"

fail() {
  id=$(printf '%s' "$1" | sed -nE 's/.*"id"[[:space:]]*:[[:space:]]*("[^"]*"|[0-9]+).*/\1/p')
  [ -n "$id" ] && printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32603,"message":"%s"}}\n' "$id" "$2"
}

while IFS= read -r line; do
  [ -n "$line" ] || continue
  out=$(printf '%s' "$line" | curl -sS --unix-socket "$sock" -X POST -H 'content-type: application/json' -H 'accept: application/json, text/event-stream' \
    --data-binary @- -w '\n%{http_code}' http://openhut/mcp 2>/dev/null) || { fail "$line" "OpenHut isn't running. Open the OpenHut app, then try again."; continue; }
  code=$(printf '%s' "$out" | tail -n 1)
  body=$(printf '%s' "$out" | sed '$d')
  if [ "$code" -ge 400 ]; then fail "$line" "OpenHut answered $code. Try again, or open the OpenHut app."; continue; fi
  printf '%s\n' "$body" | sed -e '/^event:/d' -e '/^id:/d' -e 's/^data: //' -e '/^[[:space:]]*$/d'
done
