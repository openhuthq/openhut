{
  "name": "@openhut/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "productName": "OpenHut",
  "description": "Self-hosted agents for a team, on this computer.",
  "author": "OpenHut",
  "homepage": "https://openhut.dev",
  "main": "src/main.mjs",
  "scripts": {
    "start": "node scripts/dev-name.mjs && electron .",
    "build": "vite build src/renderer",
    "dev": "vite src/renderer",
    "typecheck": "tsc -p src/renderer",
    "test": "node --test \"src/renderer/test/**/*.test.ts\" \"test/**/*.test.ts\"",
    "pack-backend": "node scripts/pack-backend.mjs",
    "dist": "npm run build && npm run pack-backend && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build && npm run pack-backend && electron-builder --win --x64 -c.extraMetadata.name=openhut --publish never",
    "dist:linux": "umask 022 && npm run build && npm run pack-backend && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.176",
    "@base-ui/react": "1.9.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capawesome/capacitor-live-update": "8.7.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@openhut/client": "*",
    "@openhut/common": "*",
    "@openhut/tunnel": "*",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.105.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.172",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.4"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "ws": "8.21.0"
  }
}
