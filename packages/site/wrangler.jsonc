{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openhut-site",
  "account_id": "4afaa879f676f237b069df558c936116",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "openhut_events" }],
  "r2_buckets": [{ "binding": "DL", "bucket_name": "openhut-releases" }],
  "ratelimits": [{ "name": "FACES_LIMIT", "namespace_id": "4207", "simple": { "limit": 30, "period": 60 } }],
  "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["no-reply@openhut.dev"] }],
  "workers_dev": false,
  "preview_urls": false
}
