{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fastmonkey-site",
  "account_id": "4afaa879f676f237b069df558c936116",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "routes": [
    { "pattern": "fastmonkey.dev", "custom_domain": true },
    { "pattern": "www.fastmonkey.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
