{
  "name": "@openhut/site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node src/build.ts",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "deploy": "npm -w @openhut/docs run build && node src/build.ts && cp -R ../../dist/site/. dist/ && wrangler deploy"
  },
  "devDependencies": {
    "@openhut/docs": "*",
    "@types/node": "26.6.2",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@openhut/common": "*"
  }
}
