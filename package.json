{
  "name": "openhut-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:reset": "rm -rf .data && echo Wiped .data: the runtime, the local cloud DB and D1.",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test",
    "e2e": "npm -w @openhut/e2e run e2e",
    "release": "scripts/release.sh",
    "postinstall": "[ ! -f scripts/private.sh ] || sh scripts/private.sh"
  },
  "devDependencies": {
    "turbo": "2.5.4",
    "typescript": "7.0.2"
  }
}
