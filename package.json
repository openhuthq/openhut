{
  "name": "openhut-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "demo": "node scripts/demo.ts",
    "seed": "node scripts/seed-ui.ts",
    "reset": "rm -rf .data && echo Wiped .data.",
    "check": "TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/main} turbo run typecheck test --affected",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "build": "turbo run build"
  },
  "devDependencies": {
    "playwright-core": "1.65.0",
    "turbo": "2.5.4",
    "typescript": "7.0.2"
  }
}
