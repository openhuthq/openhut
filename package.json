{
  "name": "openhut-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "seed": "node scripts/seed-ui.ts",
    "reset": "rm -rf .data && echo Wiped .data: the runtime and the local cloud DB.",
    "check": "TURBO_SCM_BASE=${TURBO_SCM_BASE:-origin/main} turbo run typecheck test --affected",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "build": "turbo run build",
    "app": "npm -w @openhut/desktop run build && npm -w @openhut/desktop start",
    "e2e:app": "npm -w @openhut/desktop run prove",
    "e2e:server": "npm -w @openhut/e2e run e2e",
    "release": "scripts/release.sh",
    "postinstall": "[ ! -f scripts/private.sh ] || sh scripts/private.sh"
  },
  "devDependencies": {
    "turbo": "2.5.4",
    "typescript": "7.0.2"
  }
}
