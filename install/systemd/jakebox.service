[Unit]
Description=JakeBox control plane (dashboard :8787, agent gateway :8081)
After=jakebox-agentd.service
Wants=jakebox-agentd.service

[Service]
User=jakebox
EnvironmentFile=/etc/jakebox/env
WorkingDirectory=/opt/jakebox
ExecStart=/usr/bin/env node /opt/jakebox/packages/app/src/app.ts
UMask=0077
Restart=always

[Install]
WantedBy=multi-user.target
