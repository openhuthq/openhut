[Unit]
Description=OpenHut agent firewall (before Docker, so no agent ever runs unprotected)
Before=docker.service
DefaultDependencies=no
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/openhut/env
ExecStart=/opt/openhut/install/agents-firewall.sh

[Install]
WantedBy=multi-user.target
RequiredBy=docker.service
