[Unit]
Description=JakeBox agentd (the only process that runs Docker commands for agents)
After=docker.service jakebox-firewall.service
Requires=docker.service jakebox-firewall.service

[Service]
EnvironmentFile=/etc/jakebox/env
ExecStartPre=/opt/jakebox/install/prepare.sh
ExecStartPre=/opt/jakebox/install/agents-firewall.sh
ExecStartPre=/opt/jakebox/install/pull-image.sh
ExecStart=/bin/sh -c 'APP_GID=$(id -g jakebox) exec node /opt/jakebox/packages/agentd/src/agentd.ts'
TimeoutStartSec=infinity
Restart=always

[Install]
WantedBy=multi-user.target
