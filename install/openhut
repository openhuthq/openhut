#!/bin/sh
set -eu
call() { out=$(curl -sS --unix-socket /data/app/openhut.sock -H 'content-type: application/json' "$@") || { echo "openhut: the server didn't answer. Is OpenHut up? docker logs openhut" >&2; exit 1; }
  case "$out" in *'"url"'*) printf '%s\n' "$out" | sed -n 's/.*"url":"\([^"]*\)".*/\1/p' ;; *) printf '%s\n' "$out" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p' >&2; exit 1 ;; esac; }
case "${1:-}" in
  reset-owner) call -X POST http://openhut/api/owner-resets -d '{}' >/dev/null; echo "The owner is signed out everywhere. Open OpenHut to create the owner account again." ;;
  address) if [ -n "${2:-}" ]; then call -X POST http://openhut/api/addresses -d "{\"address\":\"$2\"}"; else call http://openhut/api/addresses; fi ;;
  *) echo "usage: openhut reset-owner | address [https://new.address]
  reset-owner  signs the owner out everywhere and reopens owner sign-up (set a new email and password)
  address      prints the HTTPS address, or changes it (OpenHut gets a certificate for the new one)" >&2; exit 2 ;;
esac
